# Copy this file to `.env` and fill in your own values.
# Never commit `.env` — it is gitignored and contains secrets.

# --- App ---
RAGKB_ENV=dev
RAGKB_LOG_LEVEL=INFO

# --- LLM provider (OpenAI-compatible endpoint) ---
# Works with DeepSeek / Qwen(DashScope) / Zhipu / SiliconFlow / Moonshot / OpenAI.
RAGKB_LLM_PROVIDER=openai-compatible
RAGKB_LLM_BASE_URL=https://api.deepseek.com/v1
RAGKB_LLM_API_KEY=sk-your-llm-key
RAGKB_LLM_MODEL=deepseek-chat
RAGKB_LLM_TEMPERATURE=0.2

# --- Embedding provider ---
# "openai-compatible" + key = remote embeddings (SiliconFlow/Qwen/etc.);
#   e.g. DashScope cross-lingual text embedding:
#     RAGKB_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     RAGKB_EMBEDDING_MODEL=qwen3.7-text-embedding   (1024-dim, strong zh/en cross-lingual)
# "local" = offline CPU embeddings via sentence-transformers (BGE), data stays local:
#   RAGKB_EMBEDDING_PROVIDER=local
#   RAGKB_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5   (install: pip install -e ".[local]")
RAGKB_EMBEDDING_PROVIDER=openai-compatible
RAGKB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAGKB_EMBEDDING_API_KEY=sk-your-embedding-key
RAGKB_EMBEDDING_MODEL=BAAI/bge-m3
# Max inputs per /embeddings request (batch split). DashScope qwen3.7 caps at 20.
RAGKB_EMBEDDING_BATCH_SIZE=20

# --- Vision-language model (for schematic / image-heavy PDFs) ---
# "openai-compatible" + key = describe schematic pages via a VLM;
# "fake" = offline tests; "none" = skip (text-only fallback, no crash).
RAGKB_VLM_PROVIDER=none
RAGKB_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAGKB_VLM_API_KEY=sk-your-vlm-key
RAGKB_VLM_MODEL=qwen-vl-max
RAGKB_SCHEMATIC_MIN_CHARS_PER_PAGE=80

# --- Storage & chunking ---
RAGKB_STORE_PATH=data/ragkb.sqlite
RAGKB_CHUNK_SIZE=800
RAGKB_CHUNK_OVERLAP=100
RAGKB_RETRIEVAL_TOP_K=6

# --- Retrieval ---
# "hybrid" = BM25 + vector fused with RRF; "vector" = embedding only.
RAGKB_RETRIEVAL_MODE=hybrid
RAGKB_HYBRID_CANDIDATE_K=10
RAGKB_HYBRID_RRF_K=60
RAGKB_RERANK_PROVIDER=none

# --- Curated FAQ (question -> standard answer) ---
# FAQ entries are matched by question similarity; a match at/above the threshold is
# prepended to the context so the curated answer wins over raw docs.
RAGKB_FAQ_SCORE_THRESHOLD=0.70
RAGKB_FAQ_TOP_K=2

# --- Auth (JWT) ---
# Change the secret and admin password before deploying.
RAGKB_JWT_SECRET=change-me-in-production-use-a-long-random-secret
RAGKB_JWT_EXPIRES_MINUTES=720
RAGKB_DEFAULT_ADMIN_USERNAME=admin
RAGKB_DEFAULT_ADMIN_PASSWORD=admin123

# --- Offline development (no API key / no network) ---
# Set both providers to "fake" to run ingestion/retrieval with deterministic
# in-process providers (useful for tests and demos without keys):
#   RAGKB_LLM_PROVIDER=fake
#   RAGKB_EMBEDDING_PROVIDER=fake
